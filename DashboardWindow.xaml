<Window x:Class="ClinicaCentral.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Dashboard"
        Width="1280" Height="800" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#E6E6E6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Sidebar button (inactive) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="26,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="34" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar button (current page) -->
        <Style x:Key="NavButtonActive" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#00AEEF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="26,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="34" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White pill button -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#3B8EDB" BorderThickness="1.5"
                                CornerRadius="22" Padding="28,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White card with blue outline -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B8EDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="52"/>
            <Setter Property="Foreground" Value="#3A6BC4"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#262626">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="26,44,0,40" FontSize="26">
                    <Run Text="Clinica" Foreground="White"/><Run Text="Central" Foreground="#00AEEF"/>
                </TextBlock>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,24">
                    <Button Content="Call Center" Tag="&#xE717;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Help"        Tag="&#xE897;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Log Out"     Tag="&#xE7E8;" Style="{StaticResource NavButton}" Click="LogOut_Click"/>
                </StackPanel>

                <StackPanel>
                    <Button Content="Dashboard"        Tag="&#xE80F;" Style="{StaticResource NavButtonActive}"/>
                    <Button Content="Patient"          Tag="&#xE77B;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Staff"            Tag="&#xE716;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Appointments"     Tag="&#xE787;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Receipts"         Tag="&#xE7C3;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Staff Account"    Tag="&#xE7EF;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Settings"         Tag="&#xE713;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Backup &amp; Recovery" Tag="&#xE777;" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Welcome banner (swap the gradient for an ImageBrush if you add a photo) -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2F5FA8" Offset="0"/>
                        <GradientStop Color="#5B8FE0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Margin="32,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblWelcome" Text="Welcome back!" FontSize="30"
                                   FontWeight="ExtraBold" Foreground="White"/>
                        <TextBlock Text="Overview of your Activities for Today" FontSize="12"
                                   FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    <Button Content="Print Receipt" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,40,0" Click="PrintReceipt_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,28,30,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stat cards -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total Patients" FontSize="14"/>
                            <TextBlock x:Name="txtPatients" Text="0" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="Registered Records" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total Staffs" FontSize="14"/>
                            <TextBlock x:Name="txtStaff" Text="0" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="Registered Records" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total Appointments" FontSize="14"/>
                            <TextBlock x:Name="txtAppointments" Text="0" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="Registered Records" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Chart + staff status -->
                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Appointment Analytics" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="This week" FontSize="12" Foreground="#777"/>
                            </StackPanel>
                            <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,14,0,0"
                                    SizeChanged="ChartCanvas_SizeChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Staff Status" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" FontSize="11" Foreground="#555"/>
                                <TextBlock Grid.Column="1" Text="Role" FontSize="11" Foreground="#555"/>
                                <TextBlock Grid.Column="2" Text="Status" FontSize="11" Foreground="#555"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <ItemsControl x:Name="StaffList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="lblNoStaff" Text="No staff records yet." FontSize="12"
                                       Foreground="#888" Margin="0,10,0,6" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
