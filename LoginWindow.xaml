<Window x:Class="ClinicaCentral.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicaCentral - Login"
        Width="1100" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#8DBDF2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBox" TargetType="Border">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <Style x:Key="InputIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,0,12,0"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B84C4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A72B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E6199"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="ClinicaCentral_Logo.png" Width="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"
                       FontSize="48" FontWeight="Bold">
                <Run Text="Clinica" Foreground="White"/><Run Text="Central" Foreground="#3A6BC4"/>
            </TextBlock>
            <TextBlock Text="Your Health, Our Priority."
                       HorizontalAlignment="Center"
                       Foreground="#EAF3FF" FontSize="18"/>
        </StackPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="24"
                Margin="10,10,10,10" Padding="70,60">
            <StackPanel VerticalAlignment="Center">

                <Grid Margin="0,0,0,50">
                    <Border Width="3" Background="#1E40D8" HorizontalAlignment="Left"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="Login" FontSize="40" FontWeight="ExtraBold" Foreground="#111"/>
                        <TextBlock Text="Access your account to continue" FontSize="17" Foreground="#666"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource InputBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE77B;" Style="{StaticResource InputIcon}"/>
                        <TextBox x:Name="txtUsername" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="17" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Username or Email">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtUsername}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource InputBox}" Margin="0,0,0,40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE72E;" Style="{StaticResource InputIcon}"/>
                        <PasswordBox x:Name="txtPassword" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="17" VerticalContentAlignment="Center"
                                     PasswordChanged="TxtPassword_PasswordChanged"/>
                        <TextBlock x:Name="lblPasswordHint" Grid.Column="1"
                                   Text="Password" Style="{StaticResource Hint}"/>
                    </Grid>
                </Border>

                <Button Content="Login" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="BtnLogin_Click"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,24,0,0" FontSize="16" Foreground="#555">
                    <Run Text="Don't have an account? "/>
                    <Hyperlink Click="Register_Click" TextDecorations="None" Foreground="#1F5FBF">
                        <Run Text="Register" FontWeight="Bold"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
